<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- AnyCPU 是硬要求：WPS 表格 et.exe 是 x86，Microsoft Excel 是 x64，同一个程序集要被两种位数的宿主加载。 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChatSheet.AddIn</RootNamespace>
    <AssemblyName>ChatSheet.AddIn</AssemblyName>
    <AssemblyTitle>ChatSheet 表格 AI 助手</AssemblyTitle>
    <Product>ChatSheet</Product>
    <Version>0.1.0</Version>
    <!-- 只对入口类和窗格类显式开放 COM，不整体导出程序集。 -->
    <ComVisible>false</ComVisible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- 注册由 scripts/install.ps1 直接写 HKCU 完成，不依赖 regasm，安装端无需 SDK。 -->
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- net48 无 System.Text.Json；消息桥与四种 API 协议都要处理任意形状的 JSON。 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- 工具层与协议层是 internal，测试程序需要访问它们做真实验证。 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChatSheet.ToolTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChatSheet.PaneHarness</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Ribbon.xml" />
  </ItemGroup>

  <!-- 侧边栏 UI 是静态文件，随生成目录一起部署，运行时用 WebView2 虚拟主机映射加载，不起 HTTP 服务。 -->
  <ItemGroup>
    <None Include="..\web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
