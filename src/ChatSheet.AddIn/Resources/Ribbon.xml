<?xml version="1.0" encoding="UTF-8"?>
<!--
  用 2006 版 customUI 命名空间：Excel 2007 以上与 WPS 表格都支持。
  本机 WPS 探针加载项用的也是同一命名空间，已确认可被 ksoapi.dll 解析。
-->
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnRibbonLoad">
  <ribbon startFromScratch="false">
    <!-- WPS 12.8 may omit custom top-level tabs from the visible tab strip.
         Keep a compact entry on the built-in Home tab so the pane remains reachable. -->
    <tabs>
      <tab idMso="TabHome">
        <group id="ChatSheetHomeGroup" label="Office-helper">
          <button id="ChatSheetHomeTogglePane"
                  label="Office-helper 面板"
                  screentip="打开 Office-helper 面板"
                  supertip="在表格右侧打开 Office-helper。"
                  size="large"
                  getImage="OnGetPaneImage"
                  onAction="OnTogglePaneHome" />
        </group>
      </tab>

      <tab id="ChatSheetTab" label="Office-helper">
        <group id="ChatSheetGroup" label="AI 助手">
          <toggleButton id="ChatSheetTogglePane"
                        label="Office-helper 面板"
                        screentip="显示或隐藏右侧 Office-helper 面板"
                        supertip="在表格右侧打开对话式 AI 助手，可读取当前工作簿并在审批后修改单元格。"
                        size="large"
                        getImage="OnGetPaneImage"
                        getPressed="OnGetPanePressed"
                        onAction="OnTogglePane" />
          <separator id="ChatSheetSep1" />
          <!--
            三个按钮都给自定义图标。功能区大按钮只有标签没有图形时，
            一眼扫过去分不出彼此，而这一组以后还要继续加快捷项。
            图标与面板内同一套线条画法，见 scripts\make-ribbon-icons.ps1。
          -->
          <button id="ChatSheetSettings"
                  label="设置"
                  screentip="打开设置页"
                  supertip="配置接入模式、模型、思考开关和审批策略。"
                  size="large"
                  getImage="OnGetSettingsImage"
                  onAction="OnOpenSettings" />
          <button id="ChatSheetDiagnose"
                  label="诊断"
                  screentip="查看运行环境诊断"
                  supertip="显示宿主名称、进程位数、注册状态和 WebView2 运行时版本。"
                  size="large"
                  getImage="OnGetDiagnoseImage"
                  onAction="OnOpenDiagnostics" />
          <!--
            分隔符之后是快捷功能区：点一下就完成一件确定性的表格动作，
            不打开面板、不经过模型。这一格以后会继续加同类项，
            分隔符让它与前面「打开某个页」的三个按钮在视觉上分开。
          -->
          <separator id="ChatSheetSep2" />
          <button id="ChatSheetFitCurrentSheet"
                  label="适配当前表"
                  screentip="适配当前工作表"
                  supertip="按面板当前选择的水平对齐方式整理已用范围，并自动调整行高和列宽。不打开面板，点一下直接生效。只撤销功能区点过的适配，请用右侧的撤销按钮。"
                  size="large"
                  getImage="OnGetFitImage"
                  onAction="OnFitCurrentSheet" />
          <!--
            静态属性与它的 get 回调在 CustomUI 里互斥：同时写 label 和 getLabel
            会让 Office 校验整份 XML 失败，然后把它整个丢掉——选项卡连同全部按钮
            一起消失，且不报任何错，只表现为 onLoad 不触发（日志里少掉
            「功能区已加载」那一行）。这里的文字与说明都由回调给，
            因此一个静态的 label / supertip 都不能留。
          -->
          <button id="ChatSheetUndoRibbon"
                  getLabel="OnGetRibbonUndoLabel"
                  screentip="撤销功能区操作"
                  getSupertip="OnGetRibbonUndoSupertip"
                  getEnabled="OnGetRibbonUndoEnabled"
                  size="large"
                  getImage="OnGetUndoImage"
                  onAction="OnUndoRibbonAction" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
